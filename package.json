{
  "author": "Jules Bonnard @julesbonnard",
  "bin": {
    "apicore": "bin/run.js"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "@oclif/core": "^4.14.0",
    "afpnews-api": "next",
    "chalk": "^5.6.2",
    "natural-orderby": "^5.0.0",
    "ora": "^9.4.1",
    "string-width": "^8.2.2",
    "zod": "^4.6.5"
  },
  "description": "A modern CLI to get fresh news from apicore",
  "devDependencies": {
    "@oclif/test": "^4.2.0",
    "@types/mocha": "^10",
    "@types/node": "^26.6.2",
    "c8": "^12.0.0",
    "mocha": "^11.8.0",
    "oclif": "^4.24.0",
    "oxlint": "^1.85.0",
    "shx": "^0.4.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "/bin",
    "/dist",
    "/oclif.manifest.json"
  ],
  "homepage": "https://github.com/julesbonnard/apicore-cli",
  "license": "MIT",
  "main": "",
  "name": "@julesbonnard/apicore-cli",
  "oclif": {
    "bin": "apicore",
    "dirname": "apicore",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "plugins": [
      "@oclif/plugin-help"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julesbonnard/apicore-cli.git"
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "lint": "oxlint",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "npm run lint",
    "prepack": "npm run build && oclif manifest && oclif readme",
    "prepare": "npm run build",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "test:coverage": "c8 mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme && git add README.md"
  },
  "version": "0.6.0-next.0",
  "bugs": "https://github.com/julesbonnard/apicore-cli/issues",
  "keywords": [
    "oclif"
  ],
  "types": "dist/index.d.ts",
  "exports": "./dist/index.js",
  "type": "module"
}
