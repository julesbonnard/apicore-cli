{
  "author": "Jules Bonnard @julesbonnard",
  "bin": {
    "apicore": "./bin/run.js"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.2.0",
    "@oclif/core": "^4.8.0",
    "afpnews-api": "^2.3.0",
    "chalk": "^5.6.2",
    "lodash": "^4.17.23",
    "natural-orderby": "^5.0.0",
    "ora": "^9.3.0",
    "string-width": "^8.1.1",
    "zod": "^4.3.6"
  },
  "description": "A modern CLI to get fresh news from apicore",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5",
    "@types/lodash": "^4.17.23",
    "@types/mocha": "^10",
    "@types/node": "^25",
    "eslint": "^10",
    "eslint-plugin-n": "^17.23.2",
    "mocha": "^11",
    "oclif": "^4.22.77",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "typescript-eslint": "^8.55.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "/bin",
    "/dist",
    "/oclif.manifest.json"
  ],
  "homepage": "https://github.com/julesbonnard/apicore-cli",
  "license": "MIT",
  "main": "",
  "name": "@julesbonnard/apicore-cli",
  "oclif": {
    "bin": "apicore",
    "dirname": "apicore",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "plugins": [
      "@oclif/plugin-help"
    ]
  },
  "repository": "julesbonnard/apicore-cli",
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "lint": "eslint",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "npm run lint",
    "prepack": "npm run build && oclif manifest && oclif readme",
    "prepare": "npm run build",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme && git add README.md"
  },
  "version": "0.3.0",
  "bugs": "https://github.com/julesbonnard/apicore-cli/issues",
  "keywords": [
    "oclif"
  ],
  "types": "dist/index.d.ts",
  "exports": "./dist/index.js",
  "type": "module"
}
